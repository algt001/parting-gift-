@media (prefers-reduced-motion: reduce) {
  #face, #noise, #glitch, #play {
    animation-duration: 12s;
  }
}
</style>
</head>

<body>
<div id="screen">

  <img id="face" src="face.jpg" alt="">

  <div id="vignette"></div>
  <div id="scanlines"></div>
  <div id="noise"></div>
  <div id="glitch"></div>

  <button id="play">PLAY</button>

  <div id="intro">
    <div id="introText"></div>
  </div>

  <div id="finalMessage">
    <span>DON'T LOOK AWAY</span>
  </div>

  <audio id="menuMusic" src="music.mp3" preload="auto"></audio>
</div>

<script>
const music = document.getElementById("menuMusic");
const playButton = document.getElementById("play");
const intro = document.getElementById("intro");
const introText = document.getElementById("introText");
const finalMessage = document.getElementById("finalMessage");

const VOLUME = 0.45;
const FADE_IN = 3;
const FADE_OUT = 3;
const PAUSE = 2;

let stopped = false;
let musicStarted = false;
let gameStarted = false;

music.volume = 0;

const wait = ms =>
  new Promise(resolve => setTimeout(resolve, ms));

async function fadeTo(target, seconds) {
  const start = music.volume;
  const steps = 30;

  for (let i = 1; i <= steps; i++) {
    if (stopped) return;

    music.volume = start + (target - start) * i / steps;
    await wait(seconds * 1000 / steps);
  }
}

async function playMenuMusic() {
  if (musicStarted || stopped) return;
  musicStarted = true;

  try {
    await music.play();
  } catch (error) {
    musicStarted = false;
    return;
  }

  while (!stopped) {
    music.volume = 0;
    await fadeTo(VOLUME, FADE_IN);

    if (stopped) break;

    while (!music.ended && !stopped) {
      if (music.duration &&
          music.duration - music.currentTime <= FADE_OUT) {
        await fadeTo(0, Math.max(
          0.1, music.duration - music.currentTime
        ));
        break;
      }

      await wait(100);
    }

    music.pause();
    if (stopped) break;

    await wait(PAUSE * 1000);
    if (stopped) break;

    music.currentTime = 0;

    try {
      await music.play();
    } catch (error) {
      break;
    }
  }

  musicStarted = false;
}

document.addEventListener("pointerdown", () => {
  playMenuMusic();
}, { once: true });

async function startGame() {
  if (gameStarted) return;
  gameStarted = true;

  stopped = true;
  music.pause();

  const fade = setInterval(() => {
    music.volume = Math.max(0, music.volume - 0.05);
    if (music.volume <= 0) clearInterval(fade);
  }, 100);

  playButton.style.display = "none";
  document.getElementById("face").style.display = "none";
  document.getElementById("vignette").style.display = "none";
  document.getElementById("scanlines").style.display = "none";
  document.getElementById("noise").style.display = "none";
  document.getElementById("glitch").style.display = "none";

  intro.style.display = "flex";

  const messages = [
    "INITIALIZING CONNECTION...",
    "CONNECTION ESTABLISHED.",
    "USER DETECTED: UNKNOWN",
    "RESTORING CORRUPTED FILES...",
    "WARNING: UNKNOWN PROCESS DETECTED."
  ];

  for (const message of messages) {
    introText.textContent = message;
    await wait(1500);
  }

  await wait(700);
  intro.style.display = "none";
  finalMessage.style.display = "flex";
}

playButton.addEventListener("click", startGame);
</script>
</body>
</html>
